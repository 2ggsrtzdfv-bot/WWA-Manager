<!-- =========================================
WWA Header v1.0
========================================= -->

<header class="wwa-header">

    <div class="wwa-header-top">

        <div class="wwa-brand">
            <span class="wwa-logo">WWA</span>
        </div>

        <button class="wwa-search-btn" aria-label="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M20 20L16.6 16.6"></path>
            </svg>
        </button>

    </div>

    <div class="wwa-space">

        <p class="wwa-space-label">
            My Collection
        </p>

    </div>

</header>